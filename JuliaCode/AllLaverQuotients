function joinpartition(aa,bb,restriction)
dick=Dict([]);
for i in 1:length(aa)
for b in aa[i]
dick[b]=i;
end;
end;
while length(bb)>0
current=pop!(bb);
x=current[1];
if haskey(dick,x)==false
push!(aa,[x]);
dick[x]=length(aa);
end;
for i in 2:length(current)
y=current[i];
if haskey(dick,y)==false
dick[y]=dick[x]
if false in map(v->restriction(v,y),aa[dick[x]])
return false;
end;
push!(aa[dick[x]],y);
